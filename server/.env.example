# Copiez ce fichier en .env et renseignez vos propres valeurs.
# NE JAMAIS commiter de vrais identifiants dans ce fichier.
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/solidaid
# Secret aleatoire d'au moins 32 caracteres (ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# Origines Web autorisees, separees par des virgules.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL HTTPS publique de l'API, sans slash final.
PUBLIC_BASE_URL=
MAIL_FROM="Solid'Aid <no-reply@solidaid.fr>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
